{
  "name": "@luca-style/react",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "fonts",
    "loading",
    "DESIGN.md",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/styles.css"
    },
    "./fonts.css": "./fonts/fonts.css",
    "./licenses/*": "./fonts/*-OFL.txt"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@luca-style/tokens": "0.2.0"
  },
  "scripts": {
    "prepack": "node -e \"const fs=require('node:fs');fs.copyFileSync('../../LICENSE','LICENSE');fs.copyFileSync('../../DESIGN.md','DESIGN.md');fs.copyFileSync('../../llms.txt','llms.txt')\"",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('node:fs');fs.copyFileSync('src/styles.css','dist/styles.css');fs.copyFileSync('src/css.d.ts','dist/css.d.ts')\""
  }
}
