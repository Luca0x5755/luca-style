{
  "name": "@luca-style/tokens",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luca0x5755/luca-style.git",
    "directory": "packages/tokens"
  },
  "type": "module",
  "files": [
    "dist",
    "accent.js",
    "accent.d.ts",
    "design-tokens.md"
  ],
  "exports": {
    "./css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/tokens.css"
    },
    "./data": "./dist/tokens.json",
    "./typography": "./dist/typography.json",
    "./tailwind": {
      "types": "./dist/tailwind-preset.d.cts",
      "default": "./dist/tailwind-preset.cjs"
    },
    "./tailwind.css": {
      "types": "./dist/css.d.ts",
      "default": "./dist/tailwind-theme.css"
    },
    "./accent": {
      "types": "./accent.d.ts",
      "default": "./accent.js"
    }
  },
  "scripts": {
    "prepack": "node -e \"const fs=require('node:fs');fs.copyFileSync('../../LICENSE','LICENSE');fs.copyFileSync('../../docs/design-tokens.md','design-tokens.md')\"",
    "build": "node build.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^5.7.1"
  }
}
