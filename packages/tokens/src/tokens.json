{
  "common": {
    "control-height": "3rem",
    "font-body": "Inter, 'Noto Sans TC', sans-serif",
    "font-data": "'IBM Plex Mono', monospace",
    "space-1": "0.25rem",
    "space-2": "0.5rem",
    "space-3": "0.75rem",
    "space-4": "1rem",
    "space-6": "1.5rem",
    "space-8": "2rem",
    "space-12": "3rem",
    "space-16": "4rem",
    "motion-feedback": "120ms",
    "motion-standard": "180ms",
    "motion-region": "240ms"
  },
  "modes": {
    "light": {
      "bg": "#F7F7F2",
      "surface": "#FFFFFF",
      "surface-subtle": "#F1F3EE",
      "text": "#24312A",
      "muted": "#626F65",
      "border": "#DDE5DC",
      "control-border": "#7B8C80",
      "accent-ink": "#FFFFFF"
    },
    "dark": {
      "bg": "#151A18",
      "surface": "#1D2420",
      "surface-subtle": "#252E28",
      "text": "#EDF3ED",
      "muted": "#A5B5A8",
      "border": "#354139",
      "control-border": "#65766B",
      "accent-ink": "#151A18"
    }
  },
  "suites": {
    "vibrant": {
      "common": {
        "radius-card": "1.25rem",
        "radius-control": "1rem",
        "card-padding": "1.5rem",
        "gap-section": "2rem",
        "border-width": "1px",
        "metric-border-left": "1px",
        "metric-shadow": "0 4px 16px #00000008",
        "metric-background": "var(--accent-soft)"
      },
      "light": {
        "success": "#237354",
        "warning": "#886018",
        "error": "#B24445",
        "accent": "#147F82",
        "accent-secondary": "#DF826D",
        "accent-soft": "#E3F2F0"
      },
      "dark": {
        "success": "#7ED4AB",
        "warning": "#EAC678",
        "error": "#F29C96",
        "accent": "#64C2BC",
        "accent-secondary": "#E8A18B",
        "accent-soft": "#173637"
      }
    },
    "professional": {
      "common": {
        "radius-card": ".1875rem",
        "radius-control": ".1875rem",
        "card-padding": "1.25rem",
        "gap-section": "1.5rem",
        "border-width": "1.5px",
        "metric-border-left": "3px",
        "metric-shadow": "none",
        "metric-background": "var(--surface)"
      },
      "light": {
        "success": "#356858",
        "warning": "#80601F",
        "error": "#A34B5C",
        "accent": "#625C83",
        "accent-secondary": "#6799B9",
        "accent-soft": "#EEEDF4"
      },
      "dark": {
        "success": "#93C6B2",
        "warning": "#DBC28B",
        "error": "#DDA3B2",
        "accent": "#ABA4D7",
        "accent-secondary": "#8BBDD8",
        "accent-soft": "#2D2A3B"
      }
    }
  },
  "typography": {
    "hero": {
      "mobile": "2rem",
      "tablet": "2.75rem",
      "desktop": "3.5rem",
      "weight": 700,
      "lineHeight": 1.2
    },
    "title": {
      "mobile": "1.5rem",
      "tablet": "1.75rem",
      "desktop": "2rem",
      "weight": 700,
      "lineHeight": 1.3
    },
    "section": {
      "mobile": "1.25rem",
      "tablet": "1.375rem",
      "desktop": "1.5rem",
      "weight": 600,
      "lineHeight": 1.4
    },
    "card": {
      "mobile": "1.125rem",
      "tablet": "1.125rem",
      "desktop": "1.125rem",
      "weight": 600,
      "lineHeight": 1.5
    },
    "body": {
      "mobile": "1rem",
      "tablet": "1rem",
      "desktop": "1rem",
      "weight": 400,
      "lineHeight": 1.75
    },
    "control": {
      "mobile": "1rem",
      "tablet": "1rem",
      "desktop": "1rem",
      "weight": 500,
      "lineHeight": 1.5
    },
    "secondary": {
      "mobile": ".875rem",
      "tablet": ".875rem",
      "desktop": ".875rem",
      "weight": 400,
      "lineHeight": 1.6
    },
    "helper": {
      "mobile": ".75rem",
      "tablet": ".75rem",
      "desktop": ".75rem",
      "weight": 500,
      "lineHeight": 1.5
    }
