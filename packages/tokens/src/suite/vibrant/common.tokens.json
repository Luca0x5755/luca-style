{
  "radius-card": {
    "$value": "1.25rem",
    "$type": "dimension",
    "$description": "卡片與容器的圓角"
  },
  "radius-control": {
    "$value": "1rem",
    "$type": "dimension",
    "$description": "按鈕與操作元件的圓角"
  },
  "card-padding": {
    "$value": "1.5rem",
    "$type": "dimension",
    "$description": "卡片內距"
  },
  "gap-section": {
    "$value": "2rem",
    "$type": "dimension",
    "$description": "頁面區段之間的間距"
  },
  "border-width": {
    "$value": "1px",
    "$type": "dimension",
    "$description": "卡片與操作元件的邊框粗細"
  },
  "metric-border-left": {
    "$value": "1px",
    "$type": "dimension",
    "$description": "指標卡左側邊框的粗細"
  },
  "metric-shadow": {
    "$value": "0 4px 16px #00000008",
    "$type": "shadow",
    "$description": "指標卡的陰影；none 表示不加陰影"
  },
  "metric-background": {
    "$value": "var(--accent-soft)",
    "$type": "color",
    "$description": "指標卡的底色，可參照其他變數"
  }
}
